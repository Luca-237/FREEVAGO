PORT=3000

# Ruta al binario de Brave/Chrome que usa Puppeteer (opcional, tiene default)
BRAVE_PATH=/opt/brave.com/brave-origin/brave

# Connection string de MongoDB Atlas. Mismo cluster que ms3-armado; para
# desarrollo/pruebas usar la base "test" (agregar "/test" antes del "?").
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/test?appName=FreeVago
