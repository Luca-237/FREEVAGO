PORT=3002

# Connection string de MongoDB Atlas. Para desarrollo/pruebas, usar una base
# separada de la real (ej. agregar "/test" antes del "?" en la URI) para no
# tocar datos compartidos.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/test?appName=FreeVago

# API key de Gemini (pedila al resto del equipo, no la commitees)
GEMINI_API_KEY=

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-3.5-flash
